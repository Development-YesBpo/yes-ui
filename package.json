{
  "name": "@development-yesbpo/ui",
  "version": "1.2.0",
  "description": "YES BPO unified UI component library — 42 React components across 8 thematic waves",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Development-YesBpo/yes-ui.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens/primitives": "./dist/tokens/primitives.css",
    "./tokens/default": "./dist/tokens/semantic.css",
    "./tokens/themes/light": "./dist/tokens/themes/light.css",
    "./tokens/themes/dark": "./dist/tokens/themes/dark.css",
    "./styles/layout": "./dist/styles/layout.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "tsup && node scripts/copy-tokens.mjs",
    "build:storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "check-dist": "node scripts/check-dist.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check-dist"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.0.0",
    "@storybook/addon-docs": "^8.0.0",
    "@storybook/addon-interactions": "^8.0.0",
    "@storybook/blocks": "^8.0.0",
    "@storybook/react": "^8.0.0",
    "@storybook/react-vite": "^8.0.0",
    "@storybook/test": "^8.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/geojson": "^7946.0.14",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "clsx": "^2.1.1",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "storybook": "^8.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@ant-design/plots": "^2.6.8",
    "@antv/g-svg": "^2.1.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "maplibre-gl": "^4.7.1",
    "react-map-gl": "^7.1.7"
  }
}
